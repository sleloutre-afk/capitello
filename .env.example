# Clé de signature des sessions du back-office (obligatoire).
# Générer avec : openssl rand -hex 32
PAYLOAD_SECRET=

# Base de données.
# - Local : SQLite. Le fichier doit être HORS du disque externe T7 Shield
#   (exFAT ne gère pas le verrouillage de fichier dont SQLite a besoin).
#   ex. file:/Users/<vous>/.capitello-site/payload.db
# - Production : chaîne de connexion Postgres (postgres://...).
DATABASE_URI=

# URL publique du site (sans « / » final).
NEXT_PUBLIC_SITE_URL=http://localhost:3084

# Stockage des fichiers uploadés depuis le BO (images, PDF, vidéos).
# Laisser vide en local : les fichiers vont dans ./media.
# En production : bucket compatible S3 (Clever Cloud Cellar, Supabase Storage…).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Préproduction : « true » interdit l'indexation par les moteurs de recherche
# (robots.txt + balise noindex). À retirer à la mise en ligne sur le domaine définitif.
SITE_NOINDEX=

# Google Analytics (identifiant du site WordPress d'origine : G-6G5756Y84F).
# Laisser vide pour désactiver.
GA_MEASUREMENT_ID=

# Traduction automatique (EN/ES/ZH) des titres et chapôs saisis en français dans
# le BO. Sans clé, les publications restent en français dans toutes les langues.
ANTHROPIC_API_KEY=
